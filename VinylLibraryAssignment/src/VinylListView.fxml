<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="600.0" prefWidth="800.0"
            xmlns="http://javafx.com/javafx/11.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="VinylController"
            style="-fx-background-color: #1a1a2e;">

    <top>
        <HBox alignment="CENTER" style="-fx-background-color: #16213e; -fx-padding: 15;">
            <Label text="🎵 Vinyl Library"
                   style="-fx-text-fill: #e94560; -fx-font-size: 24; -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <!-- CENTER - Table -->
    <center>
        <TableView fx:id="vinylTable"
                   style="-fx-background-color: #16213e;"
                   BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="titleColumn" text="Title" prefWidth="200"/>
                <TableColumn fx:id="artistColumn" text="Artist" prefWidth="150"/>
                <TableColumn fx:id="yearColumn" text="Year" prefWidth="80"/>
                <TableColumn fx:id="stateColumn" text="State" prefWidth="150"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </center>

    <!-- BOTTOM - Controls -->
    <bottom>
        <VBox style="-fx-background-color: #16213e; -fx-padding: 15; -fx-spacing: 10;">

            <!-- UserId row -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="User ID:"
                       style="-fx-text-fill: #a8a8b3; -fx-font-size: 13;"/>
                <TextField fx:id="userIdField"
                           promptText="Enter your user ID..."
                           prefWidth="200"
                           style="-fx-background-color: #0f3460; -fx-text-fill: white; -fx-prompt-text-fill: #a8a8b3; -fx-background-radius: 5;"/>
            </HBox>

            <!-- Action buttons -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button fx:id="reserveButton" text="Reserve"
                        onAction="#onReserveClicked"
                        style="-fx-background-color: #0f3460; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand; -fx-pref-width: 100;"/>
                <Button fx:id="borrowButton" text="Borrow"
                        onAction="#onBorrowClicked"
                        style="-fx-background-color: #0f3460; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand; -fx-pref-width: 100;"/>
                <Button fx:id="returnButton" text="Return"
                        onAction="#onReturnClicked"
                        style="-fx-background-color: #0f3460; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand; -fx-pref-width: 100;"/>
                <Button fx:id="removeButton" text="Remove"
                        onAction="#onRemoveClicked"
                        style="-fx-background-color: #e94560; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand; -fx-pref-width: 100;"/>
            </HBox>

            <!-- Add Vinyl row -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="titleField"
                           promptText="Title..."
                           style="-fx-background-color: #0f3460; -fx-text-fill: white; -fx-prompt-text-fill: #a8a8b3; -fx-background-radius: 5;"/>
                <TextField fx:id="artistField"
                           promptText="Artist..."
                           style="-fx-background-color: #0f3460; -fx-text-fill: white; -fx-prompt-text-fill: #a8a8b3; -fx-background-radius: 5;"/>
                <TextField fx:id="yearField"
                           promptText="Year..."
                           prefWidth="80"
                           style="-fx-background-color: #0f3460; -fx-text-fill: white; -fx-prompt-text-fill: #a8a8b3; -fx-background-radius: 5;"/>
                <Button fx:id="addButton" text="+ Add Vinyl"
                        onAction="#onAddVinylClicked"
                        style="-fx-background-color: #4caf50; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;"/>
            </HBox>

        </VBox>
    </bottom>

</BorderPane>